{
  "name": "brello",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@1.22.19",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "generate": "yarn hygen generate",
    "new:component": "yarn hygen new component",
    "update-types": "npx supabase gen types typescript --project-id ddjirrggtysituolvxws > src/shared/api/supabase.ts",
    "gen:sprite": "yarn sprite --group --root src/shared/ui/icon/assets -o public/sprites -d src/shared/ui/icon/sprite.h.ts --reset-unknown-colors",
    "lint:js": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@headlessui/react": "^2.1.2",
    "@supabase/supabase-js": "^2.26.0",
    "atomic-router": "^0.10.1",
    "atomic-router-react": "^0.10.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "effector": "^23.2.2",
    "effector-react": "^23.2.1",
    "history": "^5.3.0",
    "patronum": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@neodx/svg": "^0.7.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "@vitejs/plugin-react": "^4.0.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-effector": "^0.14.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "husky": "^9.1.3",
    "hygen": "^6.2.11",
    "lint-staged": "^15.2.7",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "supabase": "^1.86.2",
    "tailwind-merge": "^2.4.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.0.7",
    "vite-plugin-svgr": "^4.2.0"
  }
